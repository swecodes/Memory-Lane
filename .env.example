# Free key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# "gemini" (default) or "ollama" for fully local models
AI_PROVIDER=gemini

# Only used when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Where photos.db, images/ and thumbs/ live. Relative paths resolve against the
# current working directory, so use an absolute path for the MCP server.
DATA_DIR=./data
