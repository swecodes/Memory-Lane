# Free key from https://console.groq.com/keys (no credit card needed).
# Used for photo captions and chat. Embeddings run locally and need no key.
GROQ_API_KEY=

# Optional model overrides (defaults are in core/ai.ts). Only change these if
# Groq retires a model; the rate limiter knows the free-tier limits by model id.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Where photos.db, images/ and thumbs/ live. Relative paths resolve against the
# current working directory, so use an absolute path for the MCP server.
DATA_DIR=./data
